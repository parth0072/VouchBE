PORT=4000

# Set this if the app is served from a sub-path rather than a domain/subdomain
# root (e.g. cPanel's Setup Node.js App wizard put it at
# alphabyteinnovation.com/vouch) — Passenger doesn't always strip the prefix
# before forwarding requests. Leave unset for local dev / root-mounted deploys.
# BASE_PATH=/vouch

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Some hosts (cPanel/shared hosting) only accept local MySQL connections via a
# Unix socket, not TCP on 3306 — if `mysql -u USER -p` connects fine but the
# app can't, use this form instead (get the path via
# `SHOW VARIABLES LIKE 'socket';` from the mysql CLI):
#   mysql://USER:PASSWORD@localhost/DATABASE?socket=/var/lib/mysql/mysql.sock
DATABASE_URL="mysql://root:password@localhost:3306/vouch"

JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Escrow hold (manual-capture PaymentIntents) + creator payouts (Transfers), §5.
# Endpoints that need this return 501 until it's set.
STRIPE_SECRET_KEY=""
# Where Stripe redirects after Connect Express onboarding (POST /payout-methods).
STRIPE_CONNECT_RETURN_URL="https://app.vouch.example.com/payouts/onboarding-complete"
STRIPE_CONNECT_REFRESH_URL="https://app.vouch.example.com/payouts/onboarding-refresh"

# Shared secret for the cron-only /internal/escrow/release-due-payouts route —
# whatever triggers the scheduled job (cron, a scheduler service) sends this as
# `X-Internal-Secret`. Not a user-facing credential.
INTERNAL_API_SECRET="change-me-too-internal"

# Base URL your OAuth apps redirect back to; social-account linking (§3.2)
# returns 501 until this and the relevant PLATFORM_CLIENT_ID/SECRET below are set.
OAUTH_REDIRECT_BASE_URL="https://api.vouch.example.com/social-accounts/callback"
# INSTAGRAM_CLIENT_ID=""
# INSTAGRAM_CLIENT_SECRET=""
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""
# YOUTUBE_CLIENT_ID=""
# YOUTUBE_CLIENT_SECRET=""
